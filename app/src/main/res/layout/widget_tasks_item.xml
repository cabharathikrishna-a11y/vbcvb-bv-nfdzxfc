<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_task_item_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="8dp"
    android:paddingRight="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <!-- Interactive Checkbox button -->
    <ImageView
        android:id="@+id/btn_task_toggle"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/bg_widget_check_inactive"
        android:src="@drawable/ic_widget_check"
        android:tint="#FFFFFF"
        android:scaleType="centerInside"
        android:padding="5dp"
        android:contentDescription="Tick off task"
        android:layout_marginEnd="9dp" />

    <!-- Clickable Task Body to open app -->
    <LinearLayout
        android:id="@+id/task_item_click_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Task Title -->
        <TextView
            android:id="@+id/item_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Task Title"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Meta info Row: Due date, Folder, Priority -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/item_task_due"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/item_task_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inbox"
                android:textColor="#94A3B8"
                android:textSize="9.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/item_task_priority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGH"
                android:textColor="#EF4444"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
