<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_black_glass"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HABIT"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:id="@+id/single_habit_streak_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_countdown_pill_upcoming"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:src="@drawable/ic_widget_flame"
                android:scaleType="centerInside"
                android:layout_marginEnd="3dp" />

            <TextView
                android:id="@+id/single_habit_streak_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0d"
                android:textColor="#F97316"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Settings to select habit -->
        <ImageView
            android:id="@+id/btn_single_habit_settings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_countdown_widget_circle_btn"
            android:src="@drawable/ic_widget_filter"
            android:tint="#94A3B8"
            android:scaleType="centerInside"
            android:padding="5dp"
            android:contentDescription="Select Habit" />
    </LinearLayout>

    <!-- Habit Content Container -->
    <LinearLayout
        android:id="@+id/single_habit_content_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/single_habit_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Habit Name"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/single_habit_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daily · 08:00 AM"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Interactive Action Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/single_habit_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tap to complete today"
            android:textColor="#A1A1AA"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Checkbox Button -->
        <ImageView
            android:id="@+id/btn_single_habit_toggle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_widget_check_inactive"
            android:src="@drawable/ic_widget_check"
            android:tint="#FFFFFF"
            android:scaleType="centerInside"
            android:padding="7dp"
            android:contentDescription="Tick off habit" />
    </LinearLayout>

</LinearLayout>
