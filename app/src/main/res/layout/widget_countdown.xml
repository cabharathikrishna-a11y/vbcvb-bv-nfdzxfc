<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_black_glass"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Header bar -->
    <LinearLayout
        android:id="@+id/countdown_header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/countdown_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COUNTDOWNS"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/countdown_count_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_countdown_pill_upcoming"
                android:text="0"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <!-- Up Arrow button: scrolls the list back to top -->
        <ImageView
            android:id="@+id/btn_scroll_top"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_countdown_widget_circle_btn"
            android:src="@drawable/ic_arrow_upward"
            android:tint="#FFFFFF"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:contentDescription="Scroll to top"
            android:layout_marginEnd="6dp" />

        <!-- Refresh button -->
        <ImageView
            android:id="@+id/btn_widget_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_countdown_widget_circle_btn"
            android:src="@drawable/ic_widget_refresh"
            android:tint="#A1A1AA"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:contentDescription="Refresh countdowns" />
    </LinearLayout>

    <!-- Scrollable ListView for Countdowns -->
    <ListView
        android:id="@+id/countdown_widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="6dp"
        android:scrollbars="vertical"
        android:nestedScrollingEnabled="true" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/countdown_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No upcoming countdowns"
        android:textColor="#71717A"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
